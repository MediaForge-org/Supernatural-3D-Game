# Normalize line endings (Fedora + Windows workflow, NTFS-backed worktree).
* text=auto eol=lf

*.sh text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Golden save files are byte-exact test fixtures: never convert line endings.
*.spnfacts -text

# Binary types (none are cleared for versioning yet; see .gitignore).
*.png binary
*.jpg binary
*.jpeg binary
*.uasset binary
*.umap binary
/Unreal/SupernaturalProt/Content/**/*.uasset filter=lfs diff=lfs merge=lfs -text
/Unreal/SupernaturalProt/Content/**/*.umap filter=lfs diff=lfs merge=lfs -text

# Save-slot golden file contains raw bytes (NUL, 0xFF): never normalize it.
*.spnsave binary
