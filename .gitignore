# === External planning master (reference only, never versioned) ===
# Planning/Master is a symlink to the external ~3 GB master archive.
# Both patterns are needed: a symlink is not a directory for git.
Planning/Master
Planning/Master/
/SPN_FULL_MASTER_*/
/SPN_FULL_CUMULATIVE_MASTER_*/

# === CMake / build outputs ===
/build/
/build-*/
/out/
cmake-build-*/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
.cache/

# === Compiler / linker artifacts ===
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.gch
*.pch
*.d
*.log
/core
/core.[0-9]*
# With core.ignorecase (Windows default) "/core" also matches the Core/ source
# directory; re-include it as a directory only, so core dump files stay ignored.
!/Core/

