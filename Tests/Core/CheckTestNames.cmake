# Fails if a doctest case name contains ';'. doctest_discover_tests (vendored doctestAddTests.cmake) splits the case list on ';', so such a
# case becomes bogus CTest entries whose filter matches nothing: they "pass" without running a single assertion. Usage: cmake -DTESTS=<exe> -P
execute_process(COMMAND "${TESTS}" --list-test-cases OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "cannot list test cases (exit ${rc})")
endif()
string(REPLACE "\n" "|" lines "${out}")
string(REPLACE ";" "<SEMICOLON>" lines "${lines}")
string(REPLACE "|" ";" lines "${lines}")
set(bad "")
foreach(line IN LISTS lines)
    if(line MATCHES "<SEMICOLON>")
        string(APPEND bad "  ${line}\n")
    endif()
endforeach()
if(bad)
    string(REPLACE "<SEMICOLON>" ";" bad "${bad}")
    message(FATAL_ERROR "test case names must not contain ';' (CTest would run them vacuously):\n${bad}")
endif()
